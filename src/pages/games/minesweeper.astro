---
import DesktopLayout from '../../layouts/DesktopLayout.astro';
import Window from '../../components/Window.astro';
import '../../styles/games.css';
import '../../styles/menubar.css';
---
<DesktopLayout title="Minesweeper — Real Serious Business">
  <Window title="Minesweeper" icon="/icons/win98/minesweeper.ico" path="/games/minesweeper" backHref="/games" defaultWidth={246} defaultHeight={334} defaultX={80} defaultY={30} noBodyScroll={true} resizable={false}>
    <!-- Scrolls only on phones, where Expert is wider than the screen; on the
         desktop the window is sized to fit the game exactly -->
    <div class="ms-viewport">
      <div class="ms" id="ms">
        <div class="win-menubar">
          <button class="win-menubar-btn" data-menu="ms-menu-game"><u>G</u>ame</button>
          <button class="win-menubar-btn" data-menu="ms-menu-help"><u>H</u>elp</button>
        </div>
        <ul class="win-dropdown ms-menu" id="ms-menu-game" role="menu">
          <li><button data-action="new">New<span class="ms-key">F2</span></button></li>
          <li class="win-dropdown-sep" role="separator"></li>
          <li><button data-level="beginner" role="menuitemradio">Beginner</button></li>
          <li><button data-level="intermediate" role="menuitemradio">Intermediate</button></li>
          <li><button data-level="expert" role="menuitemradio">Expert</button></li>
          <li class="win-dropdown-sep" role="separator"></li>
          <li><button data-action="marks" role="menuitemcheckbox">Marks (?)</button></li>
          <li class="win-dropdown-sep" role="separator"></li>
          <li><button data-action="best">Best Times...</button></li>
          <li class="win-dropdown-sep" role="separator"></li>
          <li><button data-action="exit">Exit</button></li>
        </ul>
        <ul class="win-dropdown ms-menu" id="ms-menu-help" role="menu">
          <li><button data-action="help">How to Play</button></li>
        </ul>

        <div class="ms-body">
          <div class="ms-header">
            <div class="ms-led" id="ms-mines" aria-label="Mines left"></div>
            <button class="ms-face" id="ms-face" data-face="smile" aria-label="New game"></button>
            <div class="ms-led" id="ms-time" aria-label="Seconds"></div>
          </div>
          <div class="ms-board" id="ms-board"></div>
        </div>

        <div class="ms-dialog" id="ms-dialog" hidden></div>
      </div>
    </div>
  </Window>
</DesktopLayout>

<script src="/games/minesweeper/minesweeper.js" is:inline></script>
